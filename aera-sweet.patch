diff --git a/vendorsetup.sh b/vendorsetup.sh
new file mode 100644
index 0000000..1713c54
--- /dev/null
+++ b/vendorsetup.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: Apache-2.0
+# Set AERA_BUILD_DEVICE in the invoking shell before sourcing envsetup.sh.
+if [[ "${AERA_BUILD_DEVICE:-}" == "sweet" ]]; then
+    export AERA_BUILD_STATUS=Unofficial
+    export AERA_BUILD_TYPE=Alpha
+    export AERA_PRODUCT_PREFIX=AERA
+    export AERA_VANILLA_BUILD=1
+    export AERA_AB_DEVICE=0
+    export AERA_ENABLE_ROOT_MANAGER=0
+    export AERA_ENABLE_MOBILE_DATA=0
+    export AERA_SUPPORT_FINGERPRINT=0
+    export AERA_TARGET_DEVICES="sweet,sweetin"
+    export TARGET_DEVICE_ALT="sweetin"
+fi
